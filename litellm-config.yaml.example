# Copiar este fichero a la carpeta de configuración de AI Gateway/LiteLLM.
# Los alias model_name son el único contrato que conoce la aplicación Ranger.
model_list:
  # 1. Modelo OpenAI principal para razonamiento de gobierno y chat.
  - model_name: topito
    litellm_params:
      model: openai/gpt-5.6-sol
      api_key: os.environ/OPENAI_API_KEY
      reasoning_effort: high
      drop_params: true

  # 2. Modelo Qwen local seleccionable desde Ranger Intelligence.
  # Antes de iniciar LiteLLM: ollama run qwen3.5:9b
  - model_name: qwen-local
    litellm_params:
      model: ollama/qwen3.5:9b
      api_base: http://localhost:11434
      keep_alive: -1
      drop_params: true

  # 3. Embeddings locales para Milvus (no aparece en el selector de chat).
  - model_name: embedding-local
    litellm_params:
      model: ollama/bge-m3:latest
      api_base: http://localhost:11434
      keep_alive: -1
      drop_params: true

  # 4. Guardián de seguridad (uso interno del gateway, no chat general).
  - model_name: guardian-seguridad
    litellm_params:
      model: ollama/llama-guard3
      api_base: http://localhost:11434
      keep_alive: -1
      drop_params: true

# Recomendado: configurar LITELLM_MASTER_KEY en el entorno del gateway.
general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
